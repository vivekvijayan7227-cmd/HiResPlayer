<Window x:Class="HiResPlayer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HiResPlayer — Obsidian Studio"
        Icon="assets/app_icon.png"
        Height="660" Width="1060"
        MinHeight="500" MinWidth="840"
        Background="{StaticResource Studio.Background}"
        Foreground="{StaticResource Studio.TextPrimary}"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        SizeChanged="MainWindow_SizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Studio.TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0107090E"/>
            <Setter Property="Foreground" Value="{StaticResource Studio.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Studio.SurfaceElevated}"/>
                                <Setter Property="Foreground" Value="{StaticResource Studio.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Studio.SurfaceSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0107090E"/>
            <Setter Property="Foreground" Value="{StaticResource Studio.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainRootBorder"
            Background="{StaticResource Studio.Background}"
            BorderBrush="{StaticResource Studio.Divider}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>  <!-- Row 0: Custom Obsidian Title Bar -->
                <RowDefinition Height="*"/>   <!-- Row 1: 3-Region Workspace -->
                <RowDefinition Height="90"/>  <!-- Row 2: Persistent Playback Dock -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════ ROW 0: CUSTOM OBSIDIAN TITLE BAR (36px) ═══════════════════════════════════════ -->
            <Border Grid.Row="0" x:Name="PnlTitleBar" Background="{StaticResource Studio.Background}"
                    BorderBrush="{StaticResource Studio.Divider}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Brand & Icon -->
                        <ColumnDefinition Width="*"/>    <!-- Draggable area -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Caption Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand / Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="assets/app_icon.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="HIRESPLAYER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Studio.Gold}" VerticalAlignment="Center"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource Studio.TextMuted}" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Obsidian Studio" FontSize="11" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Draggable Spacer -->
                    <Grid Grid.Column="1" Background="Transparent"/>

                    <!-- Right: Window Caption Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnWinMinimize" Content="—" ToolTip="Minimize"
                                Width="46" Height="36" Style="{StaticResource TitleBarButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="BtnWinMinimize_Click"/>
                        <Button x:Name="BtnWinMaximize" Content="☐" ToolTip="Maximize"
                                Width="46" Height="36" Style="{StaticResource TitleBarButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="BtnWinMaximize_Click"/>
                        <Button x:Name="BtnWinClose" Content="✕" ToolTip="Close"
                                Width="46" Height="36" Style="{StaticResource TitleBarCloseButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="BtnWinClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ ROW 1: 3-REGION WORKSPACE ═══════════════════════════════════════ -->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" x:Name="ColSidebar"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0" x:Name="ColQueueRail"/>
            </Grid.ColumnDefinitions>

            <!-- ── COLUMN 0: OBSIDIAN STUDIO SIDEBAR (232px, collapsible to 68px) ── -->
            <Border Grid.Column="0" Background="{StaticResource Studio.Surface}"
                    BorderBrush="{StaticResource Studio.Divider}" BorderThickness="0,0,1,0">
                <DockPanel x:Name="PnlSidebarContent" Margin="10,14">
                    <!-- Brand Title & Sidebar Collapse Toggle -->
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,20" LastChildFill="True">
                        <Button x:Name="BtnToggleSidebar" DockPanel.Dock="Right" Content="☰"
                                ToolTip="Collapse / Expand Sidebar" AutomationProperties.Name="Toggle Sidebar Navigation"
                                Style="{StaticResource Studio.IconButton}"
                                Width="32" Height="32" Click="BtnToggleSidebar_Click"
                                Foreground="{StaticResource Studio.TextMuted}"/>
                        <StackPanel x:Name="PnlBrandText" VerticalAlignment="Center">
                            <TextBlock Text="HIRESPLAYER" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Studio.Gold}" />
                            <TextBlock Text="Your listening room" FontSize="12"
                                       Foreground="{StaticResource Studio.TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Library Section Header -->
                    <TextBlock x:Name="TxtNavLibraryHeader" DockPanel.Dock="Top" Text="LIBRARY"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource Studio.Gold}"
                               Margin="12,0,0,10"/>

                    <!-- Bottom: Settings -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Settings"
                                Click="NavSettings_Click" ToolTip="Settings &amp; Engine Configuration">
                            <DockPanel>
                                <TextBlock Text="⚙" FontSize="15" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                <TextBlock x:Name="TxtNavSettings" Text="Settings" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Navigation Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button x:Name="NavSongs" Style="{StaticResource NavActiveButtonStyle}" AutomationProperties.Name="Songs Library"
                                    Click="NavSongs_Click" ToolTip="Songs (Full Library)" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="◉" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.Gold}"/>
                                    <TextBlock x:Name="TxtNavSongs" Text="Songs" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavAlbums" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Albums"
                                    Click="NavAlbums_Click" ToolTip="Albums" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="▤" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavAlbums" Text="Albums" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavArtists" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Artists"
                                    Click="NavArtists_Click" ToolTip="Artists" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="♫" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavArtists" Text="Artists" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavFolders" Style="{StaticResource NavButtonStyle}"
                                    Click="NavFolders_Click" ToolTip="Folders (Browse by Folder)" AutomationProperties.Name="Folders" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="▣" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavFolders" Text="Folders" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavFavorites" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Favorites"
                                    Click="NavFavorites_Click" ToolTip="Favorites Playlist" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="♡" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavFavorites" Text="Favorites" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavPlaylists" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Playlists"
                                    Click="NavPlaylists_Click" ToolTip="Playlists" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="≡" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavPlaylists" Text="Playlists" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>

                            <!-- Hidden alias button for backward compatibility with existing code -->
                            <Button x:Name="NavLibrary" Visibility="Collapsed" Click="NavLibrary_Click"/>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource Studio.Divider}" Margin="4,12,4,12"/>

                            <TextBlock x:Name="TxtNavStudioHeader" Text="STUDIO DSP"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource Studio.Blue}"
                                       Margin="12,0,0,10"/>

                            <Button x:Name="NavNowPlaying" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Now Playing Stage"
                                    Click="NavNowPlaying_Click" ToolTip="Now Playing (Studio Master Stage)" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="◎" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavNowPlaying" Text="Now Playing" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavEqualizer" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Equalizer"
                                    Click="NavEqualizer_Click" ToolTip="10-Band &amp; Parametric Equalizer" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="🎚" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavEqualizer" Text="Equalizer" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="NavVocalStudio" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Focus Studio"
                                    Click="NavVocalStudio_Click" ToolTip="Focus Studio &amp; Correlation Analysis" Margin="0,2">
                                <DockPanel>
                                    <TextBlock Text="🎙" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Studio.TextSecondary}"/>
                                    <TextBlock x:Name="TxtNavVocalStudio" Text="Focus Studio" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>

                            <!-- Divider & Playlists section -->
                            <Border x:Name="PnlPlaylistsDivider" Height="1" Background="{StaticResource Studio.Divider}" Margin="4,12,4,12"/>
                            <DockPanel x:Name="PnlPlaylistsHeader" Margin="8,0,4,8">
                                <TextBlock Text="PLAYLISTS" DockPanel.Dock="Left"
                                           Foreground="{StaticResource Studio.TextMuted}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button x:Name="BtnNewPlaylist" Content="+ New" DockPanel.Dock="Right"
                                        Padding="8,3" FontSize="10" FontWeight="SemiBold"
                                        Background="{StaticResource Studio.SurfaceElevated}"
                                        Foreground="{StaticResource Studio.Gold}"
                                        BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1"
                                        Cursor="Hand" Click="BtnNewPlaylist_Click"/>
                            </DockPanel>
                            <StackPanel x:Name="PnlPlaylistsList"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── COLUMN 1: MAIN CONTENT VIEWS ── -->
            <Grid Grid.Column="1">

                <!-- ══════════════════════════ VIEW 1: LIBRARY & SEARCH ══════════════════════════ -->
                <Grid x:Name="ViewLibrary" Visibility="Visible" Margin="24,20,24,14" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Page Title & Search Bar & Library Actions -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Filter Pills & Playback Actions -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Aligned Column Headers -->
                        <RowDefinition Height="*"/>    <!-- Row 3: Track List -->
                        <RowDefinition Height="Auto"/> <!-- Row 4: Dropdown Filters & Scan Status -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Page Title & Search Bar & Directory Indexing Actions -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header banner: Switches between Main Library & Active Playlist -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <!-- Mode A: Normal Library Header -->
                            <StackPanel x:Name="HeaderLibraryNormal">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Your Library" Style="{StaticResource Studio.PageTitle}"/>
                                    <Border Background="#182033" CornerRadius="4" Padding="6,2" Margin="12,6,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtLibraryCount" Text="0 tracks" FontSize="11"
                                                   Foreground="{StaticResource Studio.Gold}" FontWeight="SemiBold"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Your music, arranged your way"
                                           Foreground="{StaticResource Studio.TextSecondary}" Margin="0,4,0,0" FontSize="12.5"/>
                            </StackPanel>

                            <!-- Mode B: Active Playlist Header -->
                            <DockPanel x:Name="HeaderPlaylistView" Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Center">
                                    <Button x:Name="BtnBackToLibrary" Content="← Back to Full Library" Click="BtnBackToLibrary_Click"
                                            Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource Studio.Gold}" FontSize="12" FontWeight="SemiBold"
                                            HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtPlaylistTitle" Text="Favorites" Style="{StaticResource Studio.PageTitle}"/>
                                    <TextBlock x:Name="TxtPlaylistSubtitle" Text="0 tracks • 0:00 total"
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <!-- Search & Directory Management -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBox x:Name="TxtSearch" Width="200" Height="34" VerticalContentAlignment="Center"
                                     Style="{StaticResource Studio.TextBox}"
                                     Text="Search tracks, albums, artists..."
                                     GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                                     TextChanged="TxtSearch_TextChanged"
                                     ToolTip="Search your music library"/>
                            <Button x:Name="BtnScanFolder" Content="➕ Add Folder" Click="BtnScanFolder_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="8,0,0,0"
                                    ToolTip="Select and add a music directory to the library index" AutomationProperties.Name="Add Music Folder"/>
                            <Button x:Name="BtnRescanLibrary" Content="🔄 Rescan" Click="BtnRescanLibrary_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="6,0,0,0"
                                    ToolTip="Rescan and refresh all indexed music folders" AutomationProperties.Name="Rescan Library"/>
                            <Button x:Name="BtnOpenFlac" Content="Open FLAC" Click="BtnOpenFlac_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="6,0,0,0"
                                    ToolTip="Open a single FLAC track directly (Ctrl+O)" AutomationProperties.Name="Open FLAC File"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Filter Pills & Playback Actions -->
                    <DockPanel Grid.Row="1" Margin="0,14,0,12" LastChildFill="True">
                        <!-- Right: Playback Actions -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPlayAllLibrary" Content="▶ Play All" Click="BtnPlayAllLibrary_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                    ToolTip="Play all library tracks sequentially"/>
                            <Button x:Name="BtnShuffleAllLibrary" Content="⇄ Shuffle" Click="BtnShuffleAllLibrary_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                    ToolTip="Shuffle all tracks"/>
                            <Button x:Name="BtnAutoDiscover" Content="⟳ Auto-Discover" Click="BtnAutoDiscover_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                    ToolTip="Auto-discover music from standard folders" AutomationProperties.Name="Auto-Discover Music"/>
                            <Button x:Name="BtnClearLibrary" Content="Clear" Click="BtnClearLibrary_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="8,6" FontSize="11"
                                    ToolTip="Clear cached library tracks"/>

                            <!-- Playlist specific buttons -->
                            <Button x:Name="BtnPlayPlaylist" Content="▶ Play Playlist" Click="BtnPlayPlaylist_Click"
                                    Style="{StaticResource Studio.PrimaryButton}" Padding="12,6" FontSize="11" Margin="0,0,6,0"
                                    Visibility="Collapsed"/>
                            <Button x:Name="BtnShufflePlaylist" Content="⇄ Shuffle" Click="BtnShufflePlaylist_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                    Visibility="Collapsed"/>
                            <Button x:Name="BtnExportPlaylist" Content="↓ Export" Click="BtnExportPlaylist_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                    Visibility="Collapsed"/>
                            <Button x:Name="BtnDeletePlaylist" Content="✕ Delete" Click="BtnDeletePlaylist_Click"
                                    Style="{StaticResource Studio.ButtonBase}" Padding="8,6" FontSize="11"
                                    Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Left: Filter Pills (Songs, Albums, Artists, Folders, Favorites, Playlists) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFilterSongs" Content="Songs" Style="{StaticResource Studio.PrimaryButton}"
                                    Click="BtnFilterSongs_Click" Margin="0,0,6,0" Padding="12,5" FontSize="11.5"/>
                            <Button x:Name="BtnFilterAlbums" Content="Albums" Style="{StaticResource Studio.ButtonBase}"
                                    Click="BtnFilterAlbums_Click" Margin="0,0,6,0" Padding="12,5" FontSize="11.5"/>
                            <Button x:Name="BtnFilterArtists" Content="Artists" Style="{StaticResource Studio.ButtonBase}"
                                    Click="BtnFilterArtists_Click" Margin="0,0,6,0" Padding="12,5" FontSize="11.5"/>
                            <Button x:Name="BtnFilterFolders" Content="Folders" Style="{StaticResource Studio.ButtonBase}"
                                    Click="BtnFilterFolders_Click" Margin="0,0,6,0" Padding="12,5" FontSize="11.5"/>
                            <Button x:Name="BtnFilterFavorites" Content="Favorites" Style="{StaticResource Studio.ButtonBase}"
                                    Click="BtnFilterFavorites_Click" Margin="0,0,6,0" Padding="12,5" FontSize="11.5"/>
                            <Button x:Name="BtnFilterPlaylists" Content="Playlists" Style="{StaticResource Studio.ButtonBase}"
                                    Click="BtnFilterPlaylists_Click" Padding="12,5" FontSize="11.5"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 2: Aligned Column Headers -->
                    <Grid Grid.Row="2" Margin="10,4,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" x:Name="ColHeaderIndex"/>
                            <ColumnDefinition Width="*" x:Name="ColHeaderTitle"/>
                            <ColumnDefinition Width="140" x:Name="ColHeaderAlbum"/>
                            <ColumnDefinition Width="120" x:Name="ColHeaderResolution"/>
                            <ColumnDefinition Width="60" x:Name="ColHeaderDuration"/>
                            <ColumnDefinition Width="36" x:Name="ColHeaderFav"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="TITLE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextMuted}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="ALBUM" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextMuted}"/>
                        <TextBlock Grid.Column="3" Text="RESOLUTION" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextMuted}"/>
                        <TextBlock Grid.Column="4" Text="TIME" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextMuted}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="" FontSize="11.5" Foreground="{StaticResource Studio.TextMuted}"/>
                    </Grid>

                    <!-- Row 3: Track List -->
                    <Grid Grid.Row="3">
                        <!-- Empty Library Placeholder -->
                        <Border x:Name="PnlEmptyLibrary" Visibility="Collapsed"
                                Background="{StaticResource Studio.SurfaceElevated}"
                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1"
                                CornerRadius="12" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="♫" FontSize="42" Foreground="{StaticResource Studio.Gold}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Your library is empty" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource Studio.TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="HiResPlayer plays lossless FLAC audio files with bit-perfect WASAPI streaming and Studio DSP acoustics."
                                           Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,8,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⟳ Auto-Discover Music" Style="{StaticResource Studio.PrimaryButton}"
                                            Click="BtnAutoDiscover_Click" Padding="16,8" Margin="0,0,10,0"/>
                                    <Button Content="Scan Folder" Style="{StaticResource Studio.ButtonBase}"
                                            Click="BtnScanFolder_Click" Padding="14,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Track ListView -->
                        <ListView x:Name="LstTracks"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  MouseDoubleClick="LstTracks_MouseDoubleClick"
                                  KeyDown="LstTracks_KeyDown"
                                  ItemContainerStyle="{StaticResource Studio.TrackListItem}"
                                  Padding="0">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Studio.SurfaceElevated}"
                                                    BorderBrush="{StaticResource Studio.Divider}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,6" Margin="0,4,0,2" CornerRadius="4">
                                                <DockPanel>
                                                    <TextBlock Text="📁 " FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"
                                                               Foreground="{StaticResource Studio.Gold}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} tracks)'}" FontSize="11"
                                                               Foreground="{StaticResource Studio.TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Context Menu -->
                                        <Grid.ContextMenu>
                                            <ContextMenu Opened="TrackContextMenu_Opened" Tag="{Binding}">
                                                <MenuItem Header="▶ Play Now" Click="MenuPlayTrack_Click"/>
                                                <MenuItem Header="+ Add to Playing Next Queue" Click="MenuAddToQueue_Click"/>
                                                <Separator/>
                                                <MenuItem x:Name="MenuAddToPlaylistRoot" Header="Add to Playlist"/>
                                                <MenuItem Header="★ Toggle Favorite" Click="MenuToggleFavorite_Click"/>
                                                <MenuItem x:Name="MenuRemoveFromPlaylist" Header="✕ Remove from this Playlist" Click="MenuRemoveFromPlaylist_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Filter by this Artist" Click="MenuFilterByArtist_Click"/>
                                                <MenuItem Header="Filter by this Album" Click="MenuFilterByAlbum_Click"/>
                                                <MenuItem Header="Filter by this Genre" Click="MenuFilterByGenre_Click"/>
                                                <MenuItem Header="Filter by this Composer" Click="MenuFilterByComposer_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Open in File Explorer" Click="MenuOpenFileLocation_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <!-- Thumbnail with Live Playing Indicator -->
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7"
                                                Background="{StaticResource Studio.SurfaceElevated}"
                                                ClipToBounds="True" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="♫" FontSize="18" Foreground="{StaticResource Studio.Gold}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <!-- Playing Indicator Overlay -->
                                                <Border Background="#B007090E" Visibility="{Binding PlayingIndicatorVisibility}">
                                                    <TextBlock Text="▶" FontSize="11" Foreground="{StaticResource Studio.Gold}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Title & Artist -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource Studio.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="12"
                                                       Foreground="{StaticResource Studio.TextSecondary}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Album -->
                                        <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12"
                                                   Foreground="{StaticResource Studio.TextSecondary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                        <!-- Resolution Format Pill -->
                                        <Border Grid.Column="3" Background="{StaticResource Studio.SurfaceElevated}"
                                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1"
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormatString}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Studio.Blue}"/>
                                        </Border>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="4" Text="{Binding DurationString}" FontSize="12"
                                                   Foreground="{StaticResource Studio.TextMuted}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                        <!-- Context Action Menu Button -->
                                        <Button Grid.Column="5" Content="⋯" ToolTip="Track Actions"
                                                Style="{StaticResource Studio.IconButton}"
                                                Foreground="{StaticResource Studio.TextSecondary}"
                                                Width="32" Height="32" FontSize="16"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Click="BtnTrackMoreActions_Click" Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Row 4: Interactive Dropdown Filter Container & Scan Progress -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <!-- Collapsible Filter Bar -->
                        <Border x:Name="BarFilterContainer" Padding="14,10" Margin="0,0,0,8"
                                Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="10"
                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPlayFiltered" Content="▶ Play Filtered" Click="BtnPlayFiltered_Click"
                                            Style="{StaticResource Studio.PrimaryButton}" Padding="12,5" FontSize="11" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnQueueFiltered" Content="+ Queue All" Click="BtnQueueFiltered_Click"
                                            Style="{StaticResource Studio.ButtonBase}" Padding="10,5" FontSize="11" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnSaveFilterAsPlaylist" Content="+ Save Playlist" Click="BtnSaveFilterAsPlaylist_Click"
                                            Style="{StaticResource Studio.ButtonBase}" Padding="10,5" FontSize="11"/>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="FILTERS:" Foreground="{StaticResource Studio.Gold}"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CboFilterArtist" Width="135" Margin="0,0,8,0"
                                              DisplayMemberPath="Display" SelectionChanged="CboFilter_SelectionChanged"/>
                                    <ComboBox x:Name="CboFilterAlbum" Width="135" Margin="0,0,8,0"
                                              DisplayMemberPath="Display" SelectionChanged="CboFilter_SelectionChanged"/>
                                    <ComboBox x:Name="CboFilterGenre" Width="120" Margin="0,0,8,0"
                                              DisplayMemberPath="Display" SelectionChanged="CboFilter_SelectionChanged"/>
                                    <ComboBox x:Name="CboFilterComposer" Width="130" Margin="0,0,8,0"
                                              DisplayMemberPath="Display" SelectionChanged="CboFilter_SelectionChanged"/>
                                    <Button x:Name="BtnResetFilters" Content="Reset" Click="BtnResetFilters_Click"
                                            Style="{StaticResource Studio.ButtonBase}" Padding="8,4" FontSize="11" Margin="4,0,8,0"/>
                                    <TextBlock x:Name="TxtFilterStatus" Text="" Foreground="{StaticResource Studio.Gold}"
                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <!-- Scan Status Bar -->
                        <Border x:Name="ScanStatusBar" Visibility="Collapsed"
                                Background="{StaticResource Studio.SurfaceElevated}" Padding="16,10" CornerRadius="8"
                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="BtnCancelScan" Content="Cancel"
                                        Click="BtnCancelScan_Click" Style="{StaticResource Studio.ButtonBase}"
                                        Padding="12,4" FontSize="11"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtScanStatus" Text="Scanning..."
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="11"/>
                                    <ProgressBar x:Name="PbScan" Height="4" Minimum="0" Maximum="100"
                                                 Value="0" Margin="0,6,16,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════ VIEW 2: NOW PLAYING (STUDIO MASTER STAGE) ══════════════════════════ -->
                <Grid x:Name="ViewNowPlaying" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" x:Name="ColNpArtwork"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230" x:Name="ColNpQueue"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Vinyl / Artwork Showcase -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                    <Grid Width="180" Height="180" HorizontalAlignment="Center">
                                        <!-- Vinyl Stage (Solid Premium Dark Surface, Zero AI Gradients) -->
                                        <Border x:Name="VinylRecordStage" Width="180" Height="180" CornerRadius="90"
                                                Background="{StaticResource Studio.SurfaceElevated}"
                                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1.5">
                                            <Grid ClipToBounds="True">
                                                <Ellipse Width="160" Height="160" Stroke="#14FFFFFF" StrokeThickness="1"/>
                                                <Ellipse Width="140" Height="140" Stroke="#0AFFFFFF" StrokeThickness="1"/>
                                                <Ellipse Width="120" Height="120" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                                <Ellipse Width="100" Height="100" Stroke="#0AFFFFFF" StrokeThickness="1"/>
                                                <Ellipse Width="80" Height="80" Stroke="#14FFFFFF" StrokeThickness="1"/>
                                                <Border Width="68" Height="68" CornerRadius="34"
                                                        Background="{StaticResource Studio.Surface}"
                                                        BorderBrush="{StaticResource Studio.Gold}" BorderThickness="1.5"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="HIRES" Foreground="{StaticResource Studio.Gold}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="STUDIO" Foreground="{StaticResource Studio.TextPrimary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Studio.Background}" Stroke="{StaticResource Studio.Divider}" StrokeThickness="1" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Album Art Card -->
                                        <Border x:Name="AlbumArtCard" Width="180" Height="180" CornerRadius="12"
                                                Background="{StaticResource Studio.SurfaceElevated}"
                                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image x:Name="ImgAlbumArt" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>

                                    <!-- Quick Mode Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Button x:Name="BtnQuickBitPerfect" Content="● Direct" Click="BtnEnableBitPerfect_Click"
                                                Style="{StaticResource Studio.PrimaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnQuickDspMode" Content="● Studio DSP" Click="BtnQuickDspMode_Click"
                                                Style="{StaticResource Studio.ButtonBase}" Padding="10,5" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 1: Metadata & Live Signal Routing -->
                                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="NpTitle" Text="No Track Loaded" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Studio.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NpArtist" Text="Open a FLAC file or select from Library"
                                               FontSize="14" Foreground="{StaticResource Studio.TextSecondary}" Margin="0,3,0,1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NpAlbum" Text="HiRes Master Studio"
                                               FontSize="11" Foreground="{StaticResource Studio.TextMuted}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="14"
                                                Padding="12,5" Margin="0,0,8,0" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                            <TextBlock x:Name="NpFormatBadge" Text="FLAC • 16-bit / 44.1 kHz • Stereo"
                                                       Foreground="{StaticResource Studio.Gold}" FontWeight="SemiBold" FontSize="10"/>
                                        </Border>
                                        <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="14" Padding="10,5"
                                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Studio.Blue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="LOSSLESS STREAM" Foreground="{StaticResource Studio.Blue}" FontSize="9" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="BorderBtBadge" Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="14" Padding="10,5" Margin="8,0,0,0"
                                                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◈" Foreground="{StaticResource Studio.Blue}" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtBtBadge" Text="BLUETOOTH A2DP" Foreground="{StaticResource Studio.Blue}" FontSize="9" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Signal Chain Matrix Card -->
                                    <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                            Padding="14,12" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                    <Ellipse x:Name="NpSignalDot" Width="8" Height="8" Fill="{StaticResource Studio.Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="AUDIO ROUTING" FontWeight="Bold" Foreground="{StaticResource Studio.TextPrimary}" FontSize="11"/>
                                                </StackPanel>
                                                <Border x:Name="BadgeDacLock" Background="#2266D6A3" CornerRadius="6" Padding="8,3"
                                                        BorderBrush="{StaticResource Studio.Success}" BorderThickness="1" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="TxtDacLock" Text="● ORIGINAL" Foreground="{StaticResource Studio.Success}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </DockPanel>

                                            <Expander Header="Signal Path &amp; Engine Telemetry" IsExpanded="False"
                                                      Foreground="{StaticResource Studio.TextSecondary}" FontSize="11">
                                                <StackPanel Margin="0,8,0,0">
                                                    <Grid Margin="0,2,0,8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Studio.Surface}" CornerRadius="6" Padding="8,5" Margin="0,0,4,4">
                                                            <StackPanel>
                                                                <TextBlock Text="1. SOURCE STREAM" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Studio.TextMuted}"/>
                                                                <TextBlock x:Name="NpSignalSource" Text="16-bit / 44.1kHz PCM" FontSize="11" Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Studio.Surface}" CornerRadius="6" Padding="8,5" Margin="4,0,0,4">
                                                            <StackPanel>
                                                                <TextBlock Text="2. DSP PROCESSING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Studio.TextMuted}"/>
                                                                <TextBlock x:Name="NpSignalDsp" Text="Direct Pass-Through" FontSize="11" Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Studio.Surface}" CornerRadius="6" Padding="8,5" Margin="0,4,4,0">
                                                            <StackPanel>
                                                                <TextBlock Text="3. WASAPI TRANSPORT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Studio.TextMuted}"/>
                                                                <TextBlock x:Name="NpSignalMode" Text="Exclusive Event-Driven" FontSize="11" Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Studio.Surface}" CornerRadius="6" Padding="8,5" Margin="4,4,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="4. DAC HARDWARE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Studio.TextMuted}"/>
                                                                <TextBlock x:Name="NpSignalEndpoint" Text="Realtek Audio / DAC" FontSize="11" Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <Border Background="{StaticResource Studio.Surface}" CornerRadius="4" Padding="6,4">
                                                        <TextBlock x:Name="NpBufferStatus" Text="Buffer: 0 Underruns • Ring Buffer: Ready"
                                                                   Foreground="{StaticResource Studio.TextMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Column 2: Up Next Queue Drawer -->
                                <Border Grid.Column="2" Background="{StaticResource Studio.SurfaceElevated}"
                                        CornerRadius="14" Padding="14,12"
                                        BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <DockPanel LastChildFill="True">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock Text="≡♫" Foreground="{StaticResource Studio.Gold}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="UP NEXT" Foreground="{StaticResource Studio.TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtUpNextCount" Text="0 tracks" Foreground="{StaticResource Studio.TextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Text="Double-click track to play"
                                                   Foreground="{StaticResource Studio.TextMuted}" FontSize="9" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <ListView x:Name="LstUpNext" Background="Transparent" BorderThickness="0"
                                                  SelectionMode="Single" MaxHeight="250"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  MouseDoubleClick="LstUpNext_MouseDoubleClick" Padding="0">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" CornerRadius="6" Margin="0,2" Padding="8,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="42"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding QueueIndex}" Foreground="{StaticResource Studio.TextMuted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="4" Background="{StaticResource Studio.Surface}" ClipToBounds="True" Margin="0,0,6,0">
                                                                <Grid>
                                                                    <TextBlock Text="♫" FontSize="12" Foreground="{StaticResource Studio.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Studio.TextPrimary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Studio.TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding DurationString}" Foreground="{StaticResource Studio.TextMuted}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Spectrum Visualizer (Obsidian Studio Blue & Gold) -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="14"
                                    Padding="18,14" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Ellipse x:Name="DotVisStatus" Width="8" Height="8" Fill="{StaticResource Studio.Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtVisTitle" Text="Live 1024-Point FFT Spectrum" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Studio.TextPrimary}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtVisLegend" Text="Blue = Live FFT Spectrum • Gold = EQ Response • Green = Phase Coherent"
                                                   Foreground="{StaticResource Studio.TextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Background="{StaticResource Studio.Background}" CornerRadius="10" Height="136" ClipToBounds="True"
                                            BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                        <Canvas x:Name="CnvNowPlayingVis" Height="136" MouseMove="CnvVis_MouseMove" MouseLeave="CnvVis_MouseLeave"/>
                                    </Border>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="TxtVisReadout" Text="20 Hz - 20 kHz • Bit-Perfect 0.00 dB"
                                                   Foreground="{StaticResource Studio.TextSecondary}" FontSize="11" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtVisHover" Text="Cursor: -- Hz, -- dB"
                                                   Foreground="{StaticResource Studio.Gold}" FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════ VIEW 3: EQUALIZER ══════════════════════════ -->
                <Grid x:Name="ViewEqualizer" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,24">
                            <DockPanel Margin="0,0,0,20">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Equalizer" Style="{StaticResource Studio.PageTitle}"/>
                                    <TextBlock Text="Studio DSP — 10-Band Graphic &amp; 12-Band Parametric Equalization"
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkEqBypass" Content="Bypass" Margin="0,0,16,0"
                                              Checked="ChkEqBypass_Changed" Unchecked="ChkEqBypass_Changed"/>
                                    <ComboBox x:Name="CboPresets" Width="170" Margin="0,0,8,0"
                                              SelectionChanged="CboPresets_SelectionChanged"/>
                                    <Button Content="Save" Click="BtnSaveCustomPreset_Click" Margin="0,0,6,0" Style="{StaticResource Studio.ButtonBase}" Padding="12,6"/>
                                    <Button Content="Load" Click="BtnLoadPresetFile_Click" Margin="0,0,6,0" Style="{StaticResource Studio.ButtonBase}" Padding="12,6"/>
                                    <Button Content="Reset" Click="BtnResetEq_Click" Style="{StaticResource Studio.ButtonBase}" Padding="12,6"/>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <RadioButton x:Name="RadEqGraphic" Content="10-Band Graphic" GroupName="EqType"
                                             IsChecked="True" Margin="0,0,24,0" Checked="RadEqType_Checked"/>
                                <RadioButton x:Name="RadEqParametric" Content="12-Band Parametric" GroupName="EqType"
                                             Checked="RadEqType_Checked"/>
                            </StackPanel>

                            <!-- Calculated EQ Response Visualizer -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="18,14" Margin="0,0,0,18" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Studio.Blue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Calculated EQ Frequency Response (20 Hz - 20 kHz)"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Studio.TextSecondary}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtEqVisStatus" Text="Pass-Through: 0.0 dB"
                                                   Foreground="{StaticResource Studio.Gold}" FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Border Background="{StaticResource Studio.Background}" CornerRadius="8" Height="110" ClipToBounds="True"
                                            BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                        <Canvas x:Name="CnvEqVis" Height="110" HorizontalAlignment="Stretch" MouseMove="CnvVis_MouseMove" MouseLeave="CnvVis_MouseLeave"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Preamp Card -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" Padding="22,16" CornerRadius="12"
                                    Margin="0,0,0,18" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Preamp" Foreground="{StaticResource Studio.TextSecondary}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <Slider x:Name="SldPreamp" Grid.Column="1" Minimum="-18" Maximum="6"
                                            Value="0" TickFrequency="0.5" VerticalAlignment="Center"
                                            ValueChanged="SldPreamp_ValueChanged"/>
                                    <TextBlock x:Name="TxtPreampVal" Grid.Column="2" Text="0.0 dB"
                                               Foreground="{StaticResource Studio.Gold}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                            </Border>

                            <!-- 10-Band Graphic EQ -->
                            <Border x:Name="SecGraphicEq" Visibility="Visible"
                                    Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="22,18" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="10-Band Graphic Equalizer" FontWeight="SemiBold"
                                               Foreground="{StaticResource Studio.TextSecondary}"
                                               FontSize="12" Margin="0,0,0,18"/>
                                    <UniformGrid x:Name="GridEqBands" Columns="10" Rows="1" Height="230"/>
                                </StackPanel>
                            </Border>

                            <!-- 12-Band Parametric EQ -->
                            <Border x:Name="SecParametricEq" Visibility="Collapsed"
                                    Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="22,18" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="12-Band Parametric Equalizer" FontWeight="SemiBold"
                                               Foreground="{StaticResource Studio.TextSecondary}"
                                               FontSize="12" Margin="0,0,0,14"/>
                                    <StackPanel x:Name="PanelParametricBands"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════ VIEW 4: FOCUS STUDIO & ANALYSIS ══════════════════════════ -->
                <Grid x:Name="ViewVocalStudio" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,14,24,16">
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Focus Studio" Style="{StaticResource Studio.PageTitle}"/>
                                    <TextBlock Text="Mid/Side vocal formant focus and center attenuation with real-time spectrum analysis."
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Mode Selector -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="10"
                                    Padding="6" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadOriginal" Content="Original / Reference" GroupName="VocMode"
                                                 IsChecked="True" Margin="0,0,10,0" Checked="RadVocMode_Checked" Padding="14,6"/>
                                    <RadioButton x:Name="RadVocalsFocus" Content="Vocal Focus" GroupName="VocMode"
                                                 Margin="0,0,10,0" Checked="RadVocMode_Checked" Padding="14,6"/>
                                    <RadioButton x:Name="RadInstrumental" Content="Instrumental Focus" GroupName="VocMode"
                                                 Margin="0,0,10,0" Checked="RadVocMode_Checked" Padding="14,6"/>
                                    <Button x:Name="BtnABToggle" Content="Audition Reference (A/B)" Click="BtnABToggle_Click"
                                            Padding="14,5" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource Studio.ButtonBase}"/>
                                </StackPanel>
                            </Border>

                            <!-- Focus Response Visualizer -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="10"
                                    Padding="16,10" Margin="0,0,0,12" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Studio.Blue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Center Vocal Frequency Response (20 Hz - 20 kHz)"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Studio.TextSecondary}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtVocalVisStatus" Text="Sub-Bass &amp; High Air Anchored • Formants Isolated"
                                                   Foreground="{StaticResource Studio.Blue}" FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Border Background="{StaticResource Studio.Background}" CornerRadius="8" Height="90" ClipToBounds="True"
                                            BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                        <Canvas x:Name="CnvVocalVis" Height="90" HorizontalAlignment="Stretch" MouseMove="CnvVis_MouseMove" MouseLeave="CnvVis_MouseLeave"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Intensity Slider -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="10"
                                    Padding="18,12" Margin="0,0,0,12" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Studio.Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Phase-Coherent Focus Controls" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextPrimary}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="Adjusts mid-channel presence while maintaining stereo width and anchoring low frequencies."
                                               Foreground="{StaticResource Studio.TextMuted}" FontSize="11" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Focus Intensity" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider x:Name="SldCenterAmount" Grid.Column="1" Minimum="0" Maximum="100" Value="75" VerticalAlignment="Center"
                                                ValueChanged="SldCenterAmount_ValueChanged"/>
                                        <TextBlock x:Name="TxtCenterVal" Grid.Column="2" Text="75%" Foreground="{StaticResource Studio.Gold}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Acoustic & Phase Telemetry -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="10"
                                    Padding="18,12" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Studio.Gold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Acoustic &amp; Stereo Phase Analysis" FontWeight="SemiBold" Foreground="{StaticResource Studio.TextPrimary}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="Real-Time Measured Telemetry" Foreground="{StaticResource Studio.Gold}" FontSize="11" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource Studio.Surface}" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Stereo Phase Correlation (r)" Foreground="{StaticResource Studio.TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TxtCorrelationVal" Text="+1.00" Foreground="{StaticResource Studio.Success}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <Grid Height="6" Margin="0,2,0,6">
                                                    <Border Background="{StaticResource Studio.ProgressTrack}" CornerRadius="3"/>
                                                    <ProgressBar x:Name="PrgCorrelation" Minimum="-100" Maximum="100" Value="100" Height="6" Foreground="{StaticResource Studio.Success}"/>
                                                </Grid>
                                                <DockPanel>
                                                    <TextBlock Text="-1.0 (Out of Phase)" Foreground="{StaticResource Studio.Error}" FontSize="9"/>
                                                    <TextBlock Text="0.0 (Wide)" Foreground="{StaticResource Studio.TextMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="+1.0 (Mono/In-Phase)" Foreground="{StaticResource Studio.Success}" FontSize="9" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <TextBlock x:Name="TxtCorrelationDesc" Text="Phase coherent • Mono compatible" Foreground="{StaticResource Studio.TextMuted}" FontSize="10" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{StaticResource Studio.Surface}" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="Dynamics &amp; Headroom Management" Foreground="{StaticResource Studio.TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <DockPanel Margin="0,1,0,1">
                                                    <TextBlock Text="Pre-DSP Input Peak:" Foreground="{StaticResource Studio.TextMuted}" FontSize="10"/>
                                                    <TextBlock x:Name="TxtInPeakMeter" Text="-inf dBFS" Foreground="{StaticResource Studio.TextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,1,0,1">
                                                    <TextBlock Text="Post-DSP Output Peak:" Foreground="{StaticResource Studio.TextMuted}" FontSize="10"/>
                                                    <TextBlock x:Name="TxtOutPeakMeter" Text="-inf dBFS" Foreground="{StaticResource Studio.TextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,1,0,1">
                                                    <TextBlock Text="Limiter Gain Reduction:" Foreground="{StaticResource Studio.TextMuted}" FontSize="10"/>
                                                    <TextBlock x:Name="TxtLimiterGrMeter" Text="0.0 dB" Foreground="{StaticResource Studio.Success}" FontSize="10" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock Text="Dynamic Crest Factor:" Foreground="{StaticResource Studio.TextMuted}" FontSize="10"/>
                                                    <TextBlock x:Name="TxtCrestFactor" Text="14.2 dB (Healthy Dynamic Range)" Foreground="{StaticResource Studio.Blue}" FontSize="10" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════ VIEW 5: SETTINGS & SYSTEM CONFIGURATION ══════════════════════════ -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,24,32,32">
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Settings &amp; Engine Configuration" Style="{StaticResource Studio.PageTitle}"/>
                                <TextBlock Text="Manage audio DAC streaming, bit-perfect compliance, playback automation, and library directories"
                                           Foreground="{StaticResource Studio.TextSecondary}" FontSize="12.5" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 1. AUDIO OUTPUT AND WASAPI -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="24,20" Margin="0,0,0,20" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,16">
                                        <TextBlock Text="1. Audio Output &amp; WASAPI Configuration" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{StaticResource Studio.TextPrimary}" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Studio.Surface}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="WASAPI KERNEL STREAMING" Foreground="{StaticResource Studio.Gold}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="Output Device / Audio Endpoint" FontWeight="Medium" FontSize="12.5"
                                               Foreground="{StaticResource Studio.TextSecondary}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="CboDevices" DisplayMemberPath="FriendlyName"
                                              SelectionChanged="CboDevices_SelectionChanged" Margin="0,0,0,18"/>

                                    <TextBlock Text="WASAPI Hardware Access Mode" FontWeight="Medium" FontSize="12.5"
                                               Foreground="{StaticResource Studio.TextSecondary}" Margin="0,0,8,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="RadShared" Content="Shared Mode (Windows System Mixer)"
                                                     GroupName="WasapiMode" IsChecked="True"
                                                     Margin="0,0,32,0" Checked="RadWasapiMode_Checked"/>
                                        <RadioButton x:Name="RadExclusive" Content="Exclusive Mode (Direct Hardware Access, Zero Mixing)"
                                                     GroupName="WasapiMode" Checked="RadWasapiMode_Checked"/>
                                    </StackPanel>

                                    <Border Background="{StaticResource Studio.Surface}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="• Exclusive Mode: Grants HiResPlayer direct, bit-perfect hardware access to your DAC or sound card. Bypasses Windows audio mixing, resampling, and system notification sounds."
                                                       Foreground="{StaticResource Studio.TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Shared Mode: Routes decoded PCM through the Windows system audio mixer. Ideal when listening alongside other applications."
                                                       Foreground="{StaticResource Studio.TextMuted}" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2. ORIGINAL PLAYBACK AND STUDIO PROCESSING -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="24,20" Margin="0,0,0,20" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="2. Original Playback &amp; Studio Processing" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{StaticResource Studio.TextPrimary}" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Studio.Surface}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="FIDELITY PIPELINE" Foreground="{StaticResource Studio.Gold}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="Configure pure untouched PCM streaming vs. Studio DSP processing (10-Band EQ, 12-Band Parametric, Vocal/Instrumental Focus)."
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                    <Button x:Name="BtnEnableBitPerfect"
                                            Content="● Activate Original Mode (WASAPI Exclusive Passthrough)"
                                            Style="{StaticResource Studio.PrimaryButton}"
                                            HorizontalAlignment="Left"
                                            Click="BtnEnableBitPerfect_Click"
                                            Margin="0,0,0,12"/>

                                    <Border Background="{StaticResource Studio.Surface}" CornerRadius="8" Padding="14,10">
                                        <TextBlock Text="Bit-Perfect Eligibility Policy: When Original Mode is active, all DSP filters and resamplers are bypassed so the DAC receives original, byte-exact PCM frames. If EQ, preamp, or center focus processing is engaged, the player transparently reports 'WASAPI Exclusive — DSP Active' to maintain complete fidelity honesty."
                                                   Foreground="{StaticResource Studio.TextMuted}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 3. BLUETOOTH FIDELITY & CODEC ARCHITECTURE -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="24,20" Margin="0,0,0,20" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="3. Bluetooth Fidelity &amp; Codec Architecture" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{StaticResource Studio.TextPrimary}" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Studio.Surface}" CornerRadius="4" Padding="8,3">
                                            <TextBlock x:Name="TxtBtAdapterBadge" Text="BUILT-IN BLUETOOTH ADAPTER" Foreground="{StaticResource Studio.Blue}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="Built-in wireless audio stack monitoring, driver capability detection, and high-quality sinc polyphase resampling for Bluetooth endpoints."
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                    <CheckBox x:Name="ChkBluetoothFidelity" IsChecked="True"
                                              Content="Enable Bluetooth Fidelity Mode (Bit-Transparent Signal Path &amp; 64-Phase Sinc Resampling)"
                                              FontWeight="SemiBold" Margin="0,0,0,14" Click="ChkBluetoothFidelity_Click"/>

                                    <!-- HFP Warning -->
                                    <Border x:Name="BorderBtHfpWarning" Background="#28FF777F" BorderBrush="{StaticResource Studio.Error}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock Text="⚠" Foreground="{StaticResource Studio.Error}" FontSize="16" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Low-bandwidth Hands-Free Voice Profile (HFP / mSBC / 16 kHz) active. Switch Windows audio endpoint to 'Stereo (A2DP)' for high-fidelity music playback."
                                                       Foreground="{StaticResource Studio.Error}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Bluetooth Details -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Transport &amp; Profile:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtProfile" Grid.Row="0" Grid.Column="1" Text="Detecting..." Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Active Bluetooth Codec:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBtCodec" Text="Unknown" Foreground="{StaticResource Studio.Blue}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <Border x:Name="BorderBtConfidence" Background="{StaticResource Studio.Surface}" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TxtBtConfidence" Text="Unknown" Foreground="{StaticResource Studio.Gold}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Driver Architecture:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtDriver" Grid.Row="2" Grid.Column="1" Text="Microsoft Bluetooth A2DP Driver (BthA2dp.sys)" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="PCM Signal Path:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtPcmPath" Grid.Row="3" Grid.Column="1" Text="100% Bit-Transparent" Foreground="{StaticResource Studio.Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Wireless Losslessness:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtLossless" Grid.Row="4" Grid.Column="1" Text="Lossy Bluetooth (Perceptual Compression - Not Lossless)" Foreground="{StaticResource Studio.Warning}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Hardware Radio Adapter:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtAdapter" Grid.Row="5" Grid.Column="1" Text="Intel(R) Wireless Bluetooth(R)" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Device Bluetooth MAC:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtAddress" Grid.Row="6" Grid.Column="1" Text="N/A (Local Endpoint)" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. PLAYBACK PREFERENCES -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="24,20" Margin="0,0,0,20" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="4. Playback Preferences &amp; Automation" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource Studio.TextPrimary}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="ChkSettingsAutoAdvance" IsChecked="True"
                                              Content="Continuous Playback: Automatically advance to the next track when a song finishes" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkSettingsGapless" IsChecked="True"
                                              Content="Gapless Pre-Buffering: Prime the hardware ring buffer to eliminate inter-track silence" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkSettingsDacWarmup" IsChecked="True"
                                              Content="DAC Warmup Pre-roll: Ramp silence prior to stream initialization to protect DAC output relays" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkSettingsEnableVis" IsChecked="True"
                                              Content="Real-time Visualizer: Enable hardware audio tap for FFT spectrum and phase meters"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. LIBRARY AND STORAGE -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="24,20" Margin="0,0,0,20" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="5. Library &amp; Storage Management" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource Studio.TextPrimary}" Margin="0,0,0,10"/>
                                    <TextBlock Text="The player scans local directories for lossless FLAC files (16-bit / 24-bit PCM up to 192 kHz)."
                                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnSettingsAddFolder" Content="➕ Add Music Folder..." Click="BtnScanFolder_Click"
                                                Style="{StaticResource Studio.PrimaryButton}" Padding="14,8" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnSettingsRescan" Content="🔄 Rescan All" Click="BtnAutoDiscover_Click"
                                                Style="{StaticResource Studio.ButtonBase}" Padding="14,8" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnSettingsClear" Content="Clear Cache" Click="BtnClearLibrary_Click"
                                                Style="{StaticResource Studio.ButtonBase}" Padding="14,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 6. ADVANCED STREAM DIAGNOSTICS -->
                            <Border Background="{StaticResource Studio.SurfaceElevated}" CornerRadius="12"
                                    Padding="24,20" Margin="0,0,0,20" BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="6. Advanced Stream Diagnostics" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource Studio.TextPrimary}" Margin="0,0,0,14"/>

                                    <TextBlock x:Name="DiagStatusMsg" Text="Status: Idle" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Studio.Gold}" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bit-Perfect Eligible:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagBitPerfect" Grid.Row="0" Grid.Column="1" Text="No (DSP Active or Shared Mode)" Foreground="{StaticResource Studio.Warning}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Source Format:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagSourceFmt" Grid.Row="1" Grid.Column="1" Text="None" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output Format:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagOutputFmt" Grid.Row="2" Grid.Column="1" Text="None" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pipeline State:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagPipeline" Grid.Row="3" Grid.Column="1" Text="Processed Audio — Not Bit-perfect" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Buffer Underruns:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagUnderruns" Grid.Row="4" Grid.Column="1" Text="0" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Active Endpoint:" Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagEndpoint" Grid.Row="5" Grid.Column="1" Text="Default Device" Foreground="{StaticResource Studio.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
<!-- ── COLUMN 2: FIRST-CLASS QUEUE RAIL ("Playing next", 320px) ── -->
            <Border x:Name="BorderQueueRail" Grid.Column="2" Background="{StaticResource Studio.Surface}"
                    BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1,0,0,0"
                    Padding="14,16" Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <!-- Queue Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button x:Name="BtnCloseQueueRail" DockPanel.Dock="Right" Content="✕" AutomationProperties.Name="Close Queue Rail"
                                ToolTip="Close Queue Rail" Style="{StaticResource Studio.IconButton}"
                                Width="28" Height="28" Click="BtnCloseQueueRail_Click"
                                Foreground="{StaticResource Studio.TextMuted}"/>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="≡♫" FontSize="16" Foreground="{StaticResource Studio.Gold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Playing next" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{StaticResource Studio.TextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtQueueRailCount" Text="0 tracks in queue" FontSize="12"
                                       Foreground="{StaticResource Studio.TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Queue Quick Actions -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnQueueRailShuffle" Content="⇄ Shuffle" Style="{StaticResource Studio.ButtonBase}"
                                Padding="10,5" FontSize="11" Margin="0,0,8,0" Click="BtnQueueShuffle_Click" ToolTip="Shuffle the current queue"/>
                        <Button x:Name="BtnQueueRailClear" Content="Clear" Style="{StaticResource Studio.ButtonBase}"
                                Padding="10,5" FontSize="11" Margin="0,0,8,0" Click="BtnQueueClear_Click" ToolTip="Clear upcoming queue"/>
                        <Button x:Name="BtnQueueJumpNowPlaying" Content="◎ Stage" Style="{StaticResource Studio.ButtonBase}"
                                Padding="10,5" FontSize="11" Click="BtnQueueJumpNowPlaying_Click" ToolTip="View in Now Playing Stage"/>
                    </StackPanel>

                    <!-- Undo Notification Banner -->
                    <Border x:Name="BorderQueueUndo" DockPanel.Dock="Top" Visibility="Collapsed"
                            Background="{StaticResource Studio.SurfaceElevated}" BorderBrush="{StaticResource Studio.Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="BtnQueueUndo" DockPanel.Dock="Right" Content="Undo"
                                    Style="{StaticResource Studio.PrimaryButton}" Padding="8,3" FontSize="11"
                                    Click="BtnQueueUndo_Click"/>
                            <TextBlock x:Name="TxtQueueUndoMessage" Text="Track removed from queue" FontSize="11"
                                       Foreground="{StaticResource Studio.TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Current Playing Track Card -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Studio.SurfaceElevated}"
                            BorderBrush="{StaticResource Studio.Gold}" BorderThickness="1.5"
                            CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource Studio.SurfaceSelected}" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="♫" FontSize="16" Foreground="{StaticResource Studio.Gold}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ImgQueueCurrentArt" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock x:Name="TxtQueueCurrentTitle" Text="Nothing Playing" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Studio.Gold}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtQueueCurrentArtist" Text="Choose a track" FontSize="11"
                                           Foreground="{StaticResource Studio.TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#33F5C76A" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="PLAYING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Studio.Gold}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Upcoming Queue Tracks List -->
                    <ListView x:Name="LstQueueRail" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MouseDoubleClick="LstQueueRail_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" CornerRadius="6" Padding="4,4" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding QueueIndex}" FontSize="10.5"
                                                   Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" Background="{StaticResource Studio.SurfaceElevated}">
                                            <Grid>
                                                <TextBlock Text="♫" FontSize="11" Foreground="{StaticResource Studio.TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Medium"
                                                       Foreground="{StaticResource Studio.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="10.5"
                                                       Foreground="{StaticResource Studio.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationString}" FontSize="10.5"
                                                   Foreground="{StaticResource Studio.TextMuted}" VerticalAlignment="Center" Margin="4,0"/>
                                        <Button Grid.Column="4" Content="✕" Tag="{Binding}" Style="{StaticResource Studio.IconButton}"
                                                Width="22" Height="22" FontSize="9.5" ToolTip="Remove from Queue"
                                                Click="BtnQueueRailItemRemove_Click" Foreground="{StaticResource Studio.TextMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════ ROW 2: PERSISTENT PLAYBACK DOCK ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource Studio.Surface}"
                BorderBrush="{StaticResource Studio.Divider}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Current Track Thumbnail & Metadata -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="8"
                            Background="{StaticResource Studio.SurfaceElevated}"
                            BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="DockTrackArtPlaceholder" Text="♫" FontSize="22"
                                       Foreground="{StaticResource Studio.Gold}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="BarAlbumArt" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="165">
                        <TextBlock x:Name="BarTrackTitle" Text="Nothing Playing"
                                   Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold"
                                   FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarTrackArtist" Text="Choose a track to begin"
                                   Foreground="{StaticResource Studio.TextSecondary}" FontSize="11.5"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Transport Buttons & Seek Timeline (Centered, MaxWidth 540, Well Cleared) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540" Margin="10,0">
                    <!-- Transport Controls Row (Vertically Centered, Play Button Clear of Borders) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5">
                        <Button x:Name="BtnShuffle" Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Shuffle Mode"
                                Width="34" Height="34" VerticalAlignment="Center" Click="BtnShuffle_Click" Margin="0,0,10,0" ToolTip="Shuffle Mode">
                            <TextBlock Text="⇄" FontSize="15" Foreground="{StaticResource Studio.TextSecondary}"/>
                        </Button>
                        <Button x:Name="BtnPrev" Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Previous Track"
                                Width="34" Height="34" VerticalAlignment="Center" Click="BtnPrev_Click" Margin="0,0,10,0" ToolTip="Previous Track">
                            <TextBlock Text="|◀" FontSize="13" Foreground="{StaticResource Studio.TextSecondary}"/>
                        </Button>

                        <!-- Circular Gold Play Button (42x42, vertically centered, safe margin) -->
                        <Button x:Name="BtnPlayPause" Style="{StaticResource PlayButtonStyle}" AutomationProperties.Name="Play or Pause"
                                Width="42" Height="42" VerticalAlignment="Center" Click="BtnPlayPause_Click" ToolTip="Play / Pause"
                                Margin="0,0,10,0">
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="IconPlay" Data="M 0 0 L 14 8 L 0 16 Z"
                                      Fill="#17120A" Stroke="#17120A" StrokeThickness="1" StrokeLineJoin="Round"
                                      Width="13" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="2,0,0,0" Visibility="Visible"/>
                                <Grid x:Name="IconPause" Width="14" Height="15"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Rectangle Width="4" Height="15" Fill="#17120A" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"/>
                                    <Rectangle Width="4" Height="15" Fill="#17120A" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnStop" Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Stop Playback"
                                Width="34" Height="34" VerticalAlignment="Center" Click="BtnStop_Click" Margin="0,0,10,0" ToolTip="Stop Playback">
                            <Rectangle Width="11" Height="11" Fill="{StaticResource Studio.TextSecondary}" RadiusX="2" RadiusY="2"/>
                        </Button>
                        <Button x:Name="BtnNext" Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Next Track"
                                Width="34" Height="34" VerticalAlignment="Center" Click="BtnNext_Click" Margin="0,0,10,0" ToolTip="Next Track">
                            <TextBlock Text="▶|" FontSize="13" Foreground="{StaticResource Studio.TextSecondary}"/>
                        </Button>
                        <Button x:Name="BtnRepeat" Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Repeat Mode"
                                Width="34" Height="34" VerticalAlignment="Center" Click="BtnRepeat_Click" ToolTip="Repeat Mode">
                            <TextBlock Text="↻" FontSize="15" Foreground="{StaticResource Studio.TextSecondary}"/>
                        </Button>
                    </StackPanel>

                    <!-- Seek Row -->
                    <Grid Height="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCurrentTime" Text="0:00" Grid.Column="0"
                                   Foreground="{StaticResource Studio.TextMuted}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="SldPosition" Grid.Column="1" AutomationProperties.Name="Position Seeker" Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center" Margin="6,0"
                                IsMoveToPointEnabled="True"
                                ValueChanged="SldPosition_ValueChanged"
                                PreviewMouseLeftButtonDown="SldPosition_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="SldPosition_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="SldPosition_PreviewMouseLeftButtonUp"/>
                        <TextBlock x:Name="TxtTotalTime" Text="0:00" Grid.Column="2"
                                   Foreground="{StaticResource Studio.TextMuted}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Right: Output Device & Format Info, Queue Toggle, Volume Slider -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Accessible Audio Device & Output Format Selector Button -->
                    <Button x:Name="BtnDockDevice" Click="BtnDockDevice_Click" Focusable="True"
                            Background="Transparent" BorderThickness="0" Padding="4,2" Margin="0,0,12,0"
                            Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"
                            AutomationProperties.Name="Select Audio Output Device or WASAPI Mode"
                            ToolTip="Click to select Audio Output Device or configure WASAPI Mode">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="BarDevicePill" Text="Detecting device..."
                                       Foreground="{StaticResource Studio.TextPrimary}" FontSize="11" FontWeight="Medium"
                                       HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock x:Name="BarFormatInfo" Text="Shared Mode"
                                       Foreground="{StaticResource Studio.TextMuted}" FontSize="10.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,2,0,0"/>
                            <TextBlock x:Name="BarModeBadge" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>

                    <!-- Queue Rail Toggle Button -->
                    <Button x:Name="BtnDockNowPlaying" Content="Queue" AutomationProperties.Name="Toggle Queue Rail" ToolTip="Toggle Playing Next Queue Rail"
                            Click="BtnDockNowPlaying_Click" Style="{StaticResource Studio.ButtonBase}"
                            Padding="8,5" FontSize="11" Margin="0,0,10,0"/>

                    <!-- Master Volume Controls -->
                    <Button x:Name="BtnVolumeMute" Content="VOL" AutomationProperties.Name="Toggle Volume Mute" Click="BtnVolumeMute_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource Studio.TextSecondary}"
                            FontSize="10" FontWeight="SemiBold" Padding="3" Cursor="Hand" Margin="0,0,3,0"/>
                    <Slider x:Name="SldVolume" Width="70" AutomationProperties.Name="Volume Slider" Minimum="0" Maximum="100" Value="100"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            ValueChanged="SldVolume_ValueChanged"/>
                    <TextBlock x:Name="TxtVolumeVal" Text="100%" Width="32" Margin="4,0,0,0"
                               Foreground="{StaticResource Studio.TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════ MODAL: PLAYLIST CREATE / RENAME ══════════════════════════ -->
        <Grid x:Name="ModalPlaylistOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#C807090E" Panel.ZIndex="100">
            <Border Background="{StaticResource Studio.SurfaceElevated}" BorderBrush="{StaticResource Studio.Gold}"
                    BorderThickness="1" CornerRadius="14" Padding="28,24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtModalPlaylistTitle" Text="Create New Playlist" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Studio.TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtModalPlaylistSubtitle" Text="Enter a name for your custom playlist"
                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12" Margin="0,0,0,16"/>
                    <TextBox x:Name="TxtModalPlaylistName" Margin="0,0,0,20" Padding="12,10"
                             Style="{StaticResource Studio.TextBox}" FontSize="14" KeyDown="TxtModalPlaylistName_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnModalPlaylistCancel" Content="Cancel" Click="BtnModalPlaylistCancel_Click"
                                Style="{StaticResource Studio.ButtonBase}" Padding="16,8" Margin="0,0,10,0"/>
                        <Button x:Name="BtnModalPlaylistConfirm" Content="Create Playlist" Click="BtnModalPlaylistConfirm_Click"
                                Style="{StaticResource Studio.PrimaryButton}" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hidden elements for backward compatibility with flyout logic -->
        <Grid x:Name="QueueDockFlyout" Visibility="Collapsed"/>
        <ListView x:Name="LstQueueFlyout" Visibility="Collapsed"/>
        <TextBlock x:Name="TxtQueueFlyoutCount" Visibility="Collapsed"/>
    </Grid>
    </Border>
</Window>
