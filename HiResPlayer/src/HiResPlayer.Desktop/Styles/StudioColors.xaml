<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Studio.Background.Color">#07090E</Color>
    <Color x:Key="Studio.Surface.Color">#101521</Color>
    <Color x:Key="Studio.SurfaceElevated.Color">#182033</Color>
    <Color x:Key="Studio.SurfaceSelected.Color">#202B40</Color>
    <Color x:Key="Studio.Gold.Color">#F5C76A</Color>
    <Color x:Key="Studio.GoldHighlight.Color">#FFE5A3</Color>
    <Color x:Key="Studio.Blue.Color">#67B7FF</Color>
    <Color x:Key="Studio.TextPrimary.Color">#E8ECF4</Color>
    <Color x:Key="Studio.TextSecondary.Color">#A0A9BA</Color>
    <Color x:Key="Studio.TextMuted.Color">#737F93</Color>
    <Color x:Key="Studio.Divider.Color">#293246</Color>
    <Color x:Key="Studio.ProgressTrack.Color">#343D50</Color>
    <Color x:Key="Studio.Success.Color">#66D6A3</Color>
    <Color x:Key="Studio.Green.Color">#66D6A3</Color>
    <Color x:Key="Studio.Warning.Color">#F2B866</Color>
    <Color x:Key="Studio.Error.Color">#FF777F</Color>

    <SolidColorBrush x:Key="Studio.Background" Color="{StaticResource Studio.Background.Color}" />
    <SolidColorBrush x:Key="Studio.Surface" Color="{StaticResource Studio.Surface.Color}" />
    <SolidColorBrush x:Key="Studio.SurfaceElevated" Color="{StaticResource Studio.SurfaceElevated.Color}" />
    <SolidColorBrush x:Key="Studio.SurfaceSelected" Color="{StaticResource Studio.SurfaceSelected.Color}" />
    <SolidColorBrush x:Key="Studio.Selected" Color="{StaticResource Studio.SurfaceSelected.Color}" />
    <SolidColorBrush x:Key="Studio.Gold" Color="{StaticResource Studio.Gold.Color}" />
    <SolidColorBrush x:Key="Studio.GoldHighlight" Color="{StaticResource Studio.GoldHighlight.Color}" />
    <SolidColorBrush x:Key="Studio.Blue" Color="{StaticResource Studio.Blue.Color}" />
    <SolidColorBrush x:Key="Studio.TextPrimary" Color="{StaticResource Studio.TextPrimary.Color}" />
    <SolidColorBrush x:Key="Studio.TextSecondary" Color="{StaticResource Studio.TextSecondary.Color}" />
    <SolidColorBrush x:Key="Studio.TextMuted" Color="{StaticResource Studio.TextMuted.Color}" />
    <SolidColorBrush x:Key="Studio.Divider" Color="{StaticResource Studio.Divider.Color}" />
    <SolidColorBrush x:Key="Studio.ProgressTrack" Color="{StaticResource Studio.ProgressTrack.Color}" />
    <SolidColorBrush x:Key="Studio.Success" Color="{StaticResource Studio.Success.Color}" />
    <SolidColorBrush x:Key="Studio.Green" Color="{StaticResource Studio.Green.Color}" />
    <SolidColorBrush x:Key="Studio.Warning" Color="{StaticResource Studio.Warning.Color}" />
    <SolidColorBrush x:Key="Studio.Error" Color="{StaticResource Studio.Error.Color}" />
</ResourceDictionary>
