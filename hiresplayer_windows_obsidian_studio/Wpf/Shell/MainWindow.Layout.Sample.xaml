<Window x:Class="HiResPlayer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HiResPlayer.Desktop.Controls"
        Title="HiResPlayer" Width="1440" Height="900"
        MinWidth="980" MinHeight="640"
        Background="{StaticResource Studio.Background}"
        Foreground="{StaticResource Studio.TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Studio.TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Studio.Surface}"
                    BorderBrush="{StaticResource Studio.Divider}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28">
                        <TextBlock Text="HIRESPLAYER" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Studio.Gold}" />
                        <TextBlock Text="Your listening room" FontSize="12"
                                   Foreground="{StaticResource Studio.TextSecondary}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <Button Content="  ◉   Library" Style="{StaticResource Studio.PrimaryButton}"
                                HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="  ▤   Albums" Style="{StaticResource Studio.IconButton}"
                                HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="  ♫   Artists" Style="{StaticResource Studio.IconButton}"
                                HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="  ▣   Folders" Style="{StaticResource Studio.IconButton}"
                                HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="  ♡   Favorites" Style="{StaticResource Studio.IconButton}"
                                HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="  ≡   Playlists" Style="{StaticResource Studio.IconButton}"
                                HorizontalContentAlignment="Left" Margin="0,2" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                        <Button Content="  ⚙   Settings" Style="{StaticResource Studio.IconButton}"
                                HorizontalContentAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Your Library" Style="{StaticResource Studio.PageTitle}" />
                        <TextBlock Text="Your music, arranged your way"
                                   Foreground="{StaticResource Studio.TextSecondary}" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Height="42" VerticalContentAlignment="Center"
                             Style="{StaticResource Studio.TextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search your music" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,16">
                    <Button Content="Songs" Style="{StaticResource Studio.PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Albums" Style="{StaticResource Studio.ButtonBase}" Margin="0,0,8,0" />
                    <Button Content="Artists" Style="{StaticResource Studio.ButtonBase}" Margin="0,0,8,0" />
                    <Button Content="Folders" Style="{StaticResource Studio.ButtonBase}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="TITLE" FontSize="11"
                                   Foreground="{StaticResource Studio.TextMuted}" />
                        <TextBlock Grid.Column="2" Text="ALBUM" FontSize="11"
                                   Foreground="{StaticResource Studio.TextMuted}" />
                        <TextBlock Grid.Column="3" Text="TIME" FontSize="11"
                                   Foreground="{StaticResource Studio.TextMuted}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}"
                             SelectedItem="{Binding SelectedTrack}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource Studio.TrackListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="7"
                                            Background="{StaticResource Studio.SurfaceElevated}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="♫" FontSize="18"
                                                   Foreground="{StaticResource Studio.Gold}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="12"
                                                   Foreground="{StaticResource Studio.TextSecondary}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="13"
                                               Foreground="{StaticResource Studio.TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" FontSize="12"
                                               Foreground="{StaticResource Studio.TextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Optional queue rail -->
            <Border Grid.Column="2" Background="{StaticResource Studio.Surface}"
                    BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1,0,0,0"
                    Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,6,0,18">
                        <TextBlock Text="Playing next" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Your current queue" FontSize="12"
                                   Foreground="{StaticResource Studio.TextSecondary}" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Text="Queue items bind here"
                               Foreground="{StaticResource Studio.TextMuted}"
                               VerticalAlignment="Top" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Persistent playback dock -->
        <controls:MiniPlayer Grid.Row="1" />
    </Grid>
</Window>
