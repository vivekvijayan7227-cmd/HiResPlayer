<UserControl x:Class="HiResPlayer.Desktop.Controls.MiniPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="96">
    <Border Background="{StaticResource Studio.Surface}"
            BorderBrush="{StaticResource Studio.Divider}" BorderThickness="1,1,1,0"
            Padding="18,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="8"
                        Background="{StaticResource Studio.SurfaceElevated}">
                    <TextBlock Text="♫" FontSize="25" Foreground="{StaticResource Studio.Gold}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" Width="200">
                    <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue=Nothing Playing}"
                               Foreground="{StaticResource Studio.TextPrimary}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentTrack.Artist, TargetNullValue=Choose a track}"
                               Foreground="{StaticResource Studio.TextSecondary}" FontSize="12"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="⤨" ToolTip="Shuffle" Style="{StaticResource Studio.IconButton}"
                            Command="{Binding ToggleShuffleCommand}" AutomationProperties.Name="Toggle shuffle" />
                    <Button Content="|◀" ToolTip="Previous track" Style="{StaticResource Studio.IconButton}"
                            Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous track" />
                    <Button Content="▶" ToolTip="Play or pause" Style="{StaticResource Studio.PrimaryButton}"
                            MinWidth="48" MinHeight="44" Padding="10,4"
                            Command="{Binding PlayPauseCommand}" AutomationProperties.Name="Play or pause" />
                    <Button Content="▶|" ToolTip="Next track" Style="{StaticResource Studio.IconButton}"
                            Command="{Binding NextCommand}" AutomationProperties.Name="Next track" />
                    <Button Content="↻" ToolTip="Repeat" Style="{StaticResource Studio.IconButton}"
                            Command="{Binding ToggleRepeatCommand}" AutomationProperties.Name="Toggle repeat" />
                </StackPanel>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionText, TargetNullValue=0:00}"
                               Foreground="{StaticResource Studio.TextMuted}" FontSize="11"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            ToolTip="Seek playback position" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText, TargetNullValue=0:00}"
                               Foreground="{StaticResource Studio.TextMuted}" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="Queue" ToolTip="Show playback queue"
                        Style="{StaticResource Studio.ButtonBase}"
                        Command="{Binding OpenQueueCommand}" />
                <TextBlock Text="VOL" Foreground="{StaticResource Studio.TextMuted}"
                           FontSize="10" VerticalAlignment="Center" Margin="14,0,6,0" />
                <Slider Width="100" Minimum="0" Maximum="1"
                        Value="{Binding Volume, Mode=TwoWay}" ToolTip="Volume" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
